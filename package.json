{
  "name": "pi-next",
  "version": "0.1.0",
  "description": "Autonomous issue implementation loop extension for pi-coding-agent",
  "keywords": ["pi-package"],
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.19.0",
    "pi-coding-agent": ">=0.84.2"
  },
  "files": [
    "extensions",
    "src",
    "types",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "package.json",
    "tsconfig.json"
  ],
  "exports": {
    ".": "./extensions/pi-next.ts",
    "./coordination": "./src/coordination/index.ts",
    "./config": "./src/coordination/config.ts",
    "./authority": "./src/coordination/work-authority.ts",
    "./version": "./src/version.ts"
  },
  "pi": {
    "extensions": ["./extensions/pi-next.ts"]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typebox": "^1.3.16",
    "typescript": "^5.7.2"
  }
}
