        { "event": "worker_finished", "payload": { "adapterId": "scripted", "adapterVersion": "1", "phase": "implementation", "ok": true, "code": 0, "signal": null, "telemetryStatus": "complete" } }
      ],
      "observed": { "leaseOwned": true, "workspaceExists": true, "authorityOpen": true },
      "expect": { "nextAction": "verify_candidate", "mustNotRepeat": ["start_worker", "run_worker"] }
    },
