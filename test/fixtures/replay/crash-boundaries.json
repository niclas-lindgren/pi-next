{
  "version": 1,
  "cases": [
    {
      "version": 1,
      "name": "crash after lease claim before worker start",
      "runId": "replay-lease-claim",
      "issueNumber": 701,
      "events": [
        { "event": "lease_claimed", "payload": { "agent": "pi-next", "branch": "agent/issue-701", "worktree": ".worktrees/issue-701" } },
        { "event": "workspace_prepared", "payload": { "branch": "agent/issue-701", "worktree": ".worktrees/issue-701" } }
      ],
      "observed": { "leaseOwned": true, "workspaceExists": true, "authorityOpen": true },
      "expect": { "nextAction": "start_worker", "mustNotRepeat": ["claim_lease", "prepare_workspace"] }
    },
