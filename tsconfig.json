{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".pi", ".worktrees"]
}
