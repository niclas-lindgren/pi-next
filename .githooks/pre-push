#!/bin/sh
set -eu

main_push=0
main_local_sha=""
main_remote_sha=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    main_push=1
    main_local_sha=$local_sha
    main_remote_sha=$remote_sha
  fi
done

[ "$main_push" -eq 1 ] || exit 0

if [ "$main_remote_sha" = "0000000000000000000000000000000000000000" ]; then
  base=$(git rev-list --max-parents=0 "$main_local_sha" | tail -n 1)
else
  base=$main_remote_sha
fi
changed=$(git diff --name-only "$base..$main_local_sha")

old_version=""
if [ "$main_remote_sha" != "0000000000000000000000000000000000000000" ]; then
  old_version=$(git show "$main_remote_sha:package.json" 2>/dev/null | node -e 'let s=""; process.stdin.on("data", d => s += d).on("end", () => { try { console.log(JSON.parse(s).version || ""); } catch {} });' || true)
fi
new_version=$(node -e 'console.log(JSON.parse(require("fs").readFileSync("package.json", "utf8")).version || "")')

if printf '%s\n' "$changed" | grep -Eq '^(extensions/|src/|skills/|package\.json$|package-lock\.json$)' && [ -n "$old_version" ] && [ "$old_version" = "$new_version" ]; then
  release_level=${PI_NEXT_RELEASE_LEVEL:-patch}
  case "$release_level" in
    patch|minor|major) ;;
    *)
      echo "pre-push: PI_NEXT_RELEASE_LEVEL must be patch, minor, or major (got $release_level)." >&2
      exit 1
      ;;
  esac
  echo "pre-push: main contains package changes without a version bump ($new_version)." >&2
  echo "pre-push: preparing the next $release_level release with make release..." >&2
  make release RELEASE_LEVEL="$release_level"
  echo "pre-push: release commit/tag created; push was stopped safely." >&2
  echo "pre-push: rerun with: git push --follow-tags" >&2
  # A pre-push hook cannot safely replace the ref being pushed: release
  # creates a commit and tag, and continuing would race the original refspec.
  # Stop here so the caller explicitly pushes the new release boundary.
  exit 1
fi

echo "pre-push: validating main before push (build + lint only; tests run at release time)..."
make lint
